# Production TLS should terminate at a managed load balancer/reverse proxy.
# If Nginx terminates TLS, mount certificates from the enterprise certificate store.
server {
    listen 443 ssl http2;
    server_name assistant.example.com;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    client_max_body_size 10m;
    proxy_read_timeout 35s;
    proxy_send_timeout 35s;

    location /api/ {
        proxy_pass http://nanvi-api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
    }
}
