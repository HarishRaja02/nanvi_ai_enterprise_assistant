# Development only. Production identity must be provided by the backend-managed OIDC flow.
VITE_DEMO_MODE=true

# Optional: fully-qualified company SSO authorization URL configured by deployment.
VITE_SSO_LOGIN_URL=

# Optional: API base URL if backend is hosted on a separate domain (e.g. https://my-backend.railway.app).
# Leave empty if using Vercel rewrites or local proxy (defaults to /api).
VITE_API_BASE_URL=

# Optional: External CDN / hosted links if you do not want to serve video/images from local project folders.
# If omitted, Nanvi automatically uses the local bundled assets in the public folder.
VITE_HERO_VIDEO_URL=
VITE_LOGO_URL=
VITE_ICON_URL=
