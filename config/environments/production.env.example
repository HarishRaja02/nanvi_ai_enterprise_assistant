APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<from-secret-store>
OIDC_CLIENT_SECRET=<from-secret-store-or-remove-for-pure-public-client>
OIDC_REDIRECT_URI=https://assistant.example.com/api/auth/callback
OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
OIDC_AUDIENCE=<api-client-id>
OIDC_ALGORITHMS=RS256
DATABASE_URL=<from-secret-store>
REDIS_URL=<from-secret-store>
COMPANY_FILE_ROOTS=Customers=/srv/company-data/Customers;Finance=/srv/company-data/Finance;HR=/srv/company-data/HR;Projects=/srv/company-data/Projects;Contracts=/srv/company-data/Contracts
COMPANY_FILE_MAX_SIZE_BYTES=10485760
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=20
DATABASE_STATEMENT_TIMEOUT_MS=5000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
OTEL_ENABLED=true
OTEL_SERVICE_NAME=nanvi-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
CORS_ORIGINS=https://assistant.example.com
HSTS_ENABLED=true
