# ==============================================================================
# Nanvi Enterprise Assistant — Environment Configuration Template
# NOTE: DO NOT commit sensitive production credentials or actual secrets here.
# Copy this file to .env and supply the real secret values in your deployment environment.
# ==============================================================================

# Application Runtime Mode: development | demo | production | testing
# Defaults to "production" (fail-closed) if unset.
APP_MODE=development
APP_ENV=development
DEBUG=false

# LLM Configuration
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# Optional native realtime voice provider. Keep this key server-side only.
# GPT-Live voice is enabled when OPENAI_API_KEY is set; set REALTIME_VOICE_ENABLED=false to disable it.
OPENAI_API_KEY=
REALTIME_VOICE_ENABLED=false
REALTIME_VOICE_MODEL=gpt-live-1

# Web Search
TAVILY_API_KEY=tvly-your_tavily_api_key_placeholder

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nanvi
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_placeholder
SUPABASE_DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Security, Cryptography & JWT
JWT_SECRET=your_32_character_minimum_random_secret_string_here
ENCRYPTION_KEY=your_32_character_master_encryption_key_here
ENCRYPTION_KEY_ID=v1

# Nanvi-managed local accounts. Passwords are stored as scrypt hashes.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_TENANT_ID=enterprise-tenant
# Optional SQLite path for local development; production uses DATABASE_URL/SUPABASE_DATABASE_URL.
LOCAL_AUTH_DB_PATH=./storage/local_accounts.sqlite3
# Required in production to bootstrap the first Superior account; store these in a secrets manager.
LOCAL_AUTH_BOOTSTRAP_USERNAME=superior
LOCAL_AUTH_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
LOCAL_AUTH_BOOTSTRAP_NAME=Superior Administrator
LOCAL_AUTH_BOOTSTRAP_EMAIL=superior@example.com

# OAuth 2.0 Providers
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:5173

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional folder-browser shortcuts (Name=Path separated by semicolons).
# Administrators can also choose any other folder accessible to the backend machine.
COMPANY_FILE_ROOTS=Customers=./storage/company_data/Customers;Finance=./storage/company_data/Finance;HR=./storage/company_data/HR;Projects=./storage/company_data/Projects;Contracts=./storage/company_data/Contracts

# Demo Auth (Must be false in production)
DEMO_AUTH_ENABLED=false
ALLOW_LEGACY_GMAIL_TOKEN=false

# CORS & Networking
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
